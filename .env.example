# ==============================================================================
# KnowledgeHub Environment Configuration Template
# Copy this file to .env and adjust variables for your local or production environment
# ==============================================================================

# Application & Environment
APP_NAME=KnowledgeHub
ENVIRONMENT=development
DEBUG=true
API_V1_STR=/api/v1
SECRET_KEY=generate_a_super_secure_random_secret_key_change_in_production_min32chars
ACCESS_TOKEN_EXPIRE_MINUTES=60

# CORS Settings (Comma-separated origins)
BACKEND_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Database (PostgreSQL with pgvector)
# For local Docker Compose:
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/knowledgehub
# For testing fallback when running isolated local pytest:
# DATABASE_URL=sqlite:///./test_knowledgehub.db

# Object Storage (S3 / MinIO)
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=knowledgehub-documents
S3_REGION=us-east-1
S3_USE_SSL=false

# Task Queue (Celery & Redis)
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# LLM & Embedding Service (OpenAI or OpenAI-compatible endpoint)
OPENAI_API_KEY=sk-placeholder-replace-with-your-real-key
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-4o-mini
EMBEDDING_DIMENSIONS=1536

# RAG & Retrieval Pipeline Settings
CHUNK_SIZE=800
CHUNK_OVERLAP=150
TOP_K_RETRIEVAL=8
RRF_K_CONSTANT=60
ENABLE_RERANKER=true
RERANK_TOP_K=5

# Rate Limiting & Safety
RATE_LIMIT_PER_MINUTE=60
MAX_UPLOAD_SIZE_MB=50
